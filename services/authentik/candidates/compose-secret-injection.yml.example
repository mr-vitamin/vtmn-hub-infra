# REVIEW-ONLY example. Not auto-loaded. Match the installed release first.
# Use the existing provider/client value; this is not credential generation.
services:
  server:
    environment:
      NEXTCLOUD_OIDC_CLIENT_SECRET: ${NEXTCLOUD_OIDC_CLIENT_SECRET:?Provide the existing Nextcloud OIDC client secret}
  worker:
    environment:
      NEXTCLOUD_OIDC_CLIENT_SECRET: ${NEXTCLOUD_OIDC_CLIENT_SECRET:?Provide the existing Nextcloud OIDC client secret}
