# Copy to .env in each service directory (or a shared one, adjusted to taste) and fill in real values.
# Never commit the filled-in .env file — it's already covered by .gitignore.

# --- Authentik (services/authentik) ---
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=

# --- Snipe-IT (services/snipeit) ---
SNIPEIT_APP_KEY=
SNIPEIT_DB_PASSWORD=
SNIPEIT_DB_ROOT_PASSWORD=

# --- Wiki.js (services/wikijs) ---
WIKIJS_DB_PASSWORD=

# --- Nextcloud (services/nextcloud) ---
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_DB_ROOT_PASSWORD=

# --- OIDC client secrets registered in Authentik (services/authentik/blueprints) ---
NEXTCLOUD_OIDC_CLIENT_SECRET=
WIKIJS_OIDC_CLIENT_SECRET=
