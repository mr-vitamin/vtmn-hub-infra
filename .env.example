# Blank reference only. For each stack, select only its required variables in a private env source.
# Recover existing values for an initialized deployment; do not generate replacements during rebuild.
# See docs/APPLICATION-OPERATIONS.md for required inputs, key formats and continuity.
# Never commit the filled-in .env file — it's already covered by .gitignore.

# --- Authentik (services/authentik) ---
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=

# --- Snipe-IT (services/snipeit) ---
SNIPEIT_APP_KEY=
SNIPEIT_DB_PASSWORD=
SNIPEIT_DB_ROOT_PASSWORD=

# --- Wiki.js (services/wikijs) ---
WIKIJS_DB_PASSWORD=

# --- Nextcloud (services/nextcloud) ---
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_DB_ROOT_PASSWORD=

# --- OIDC setup inputs; NOT automatically interpolated into Authentik blueprints ---
# These require the separately reviewed, version-supported provider/application wiring.
NEXTCLOUD_OIDC_CLIENT_SECRET=
WIKIJS_OIDC_CLIENT_SECRET=
